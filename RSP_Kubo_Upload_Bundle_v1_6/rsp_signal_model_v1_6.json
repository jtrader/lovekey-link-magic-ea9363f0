{
  "protocol": "Respectful Synchronised Protocol",
  "version": "1.6",
  "core_flow": [
    "observe_minimum_required_event",
    "check_consent",
    "normalise_event",
    "apply_weight",
    "aggregate_to_node_signal",
    "render_visual_state",
    "expire_signal",
    "burn_or_decouple_identifiable_source"
  ],
  "example_weights": {
    "pageView": 1,
    "scroll50": 3,
    "scroll90": 5,
    "elementClick": 8,
    "activeMinute": 10,
    "formInteraction": 12,
    "resourceDownload": 15,
    "returnVisit": 20,
    "completionOrConversion": 25,
    "humanCorrection": 12,
    "agentHandoff": 10,
    "safetyEscalation": 20,
    "quizRetry": 8,
    "videoRewind": 6
  },
  "visual_states": [
    "dormant",
    "aware",
    "active",
    "resonant",
    "friction",
    "overload",
    "drop_off",
    "support_needed",
    "cooling",
    "converting",
    "mastery",
    "coordination_degraded",
    "coordination_healthy"
  ],
  "privacy_controls": [
    "minimal_disclosure",
    "consent_scope",
    "signal_expiry",
    "source_burn",
    "aggregation",
    "anonymisation",
    "cryptographic_erasure",
    "local_processing_where_possible"
  ]
}